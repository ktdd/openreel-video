{
    "name": "openreel",
    "version": "0.1.2",
    "private": true,
    "description": "Professional video, audio, and photo editing in your browser",
    "type": "module",
    "scripts": {
        "dev": "bun run --filter @openreel/web dev",
        "build:wasm": "bun run --filter @openreel/core build:wasm",
        "build": "bun run build:wasm && bun run --filter @openreel/web build",
        "preview": "bun run --filter @openreel/web preview",
        "test": "bun run --filter '@openreel/*' test:run",
        "test:watch": "bun run --filter '@openreel/*' test",
        "lint": "bun run --filter '@openreel/*' lint",
        "check:retired-cloud-gpu": "node scripts/check-retired-cloud-gpu.mjs",
        "check:no-ai": "node scripts/check-no-ai.mjs && node scripts/check-retired-cloud-gpu.mjs",
        "check:release-browser": "node scripts/validate-ai-removal-release.mjs .codex-audit/phase5/wide && node scripts/validate-ai-removal-release.mjs .codex-audit/phase5/compact --compact",
        "typecheck": "bun run --filter '@openreel/*' typecheck",
        "clean": "bun run --filter '@openreel/*' clean"
    },
    "keywords": [
        "video-editor",
        "audio-editor",
        "browser-based",
        "webcodecs",
        "webgpu",
        "react",
        "typescript",
        "open-source",
        "video-editing",
        "timeline",
        "color-grading",
        "export"
    ],
    "author": "Augustus Otu and Contributors",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Augani/openreel-video.git"
    },
    "bugs": {
        "url": "https://github.com/Augani/openreel-video/issues"
    },
    "homepage": "https://openreel.video",
    "engines": {
        "node": ">=18.0.0",
        "bun": ">=1.4.3"
    },
    "packageManager": "bun@1.4.3",
    "patchedDependencies": {
        "@ffmpeg/core@0.12.6": "patches/@ffmpeg__core@0.12.6.patch",
        "@ffmpeg/core-mt@0.12.6": "patches/@ffmpeg__core-mt@0.12.6.patch"
    },
    "dependencies": {
        "@ffmpeg/core": "0.12.6",
        "@ffmpeg/core-mt": "0.12.6",
        "mediabunny": "^1.25.3"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "@astryxdesign/cli": "^0.1.1",
        "@types/node": "^22.0.0"
    }
}